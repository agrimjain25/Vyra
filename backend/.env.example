# VYRA backend configuration. Copy this file to ".env" (same folder) and fill in YOUR values.
# Never commit ".env" and never paste keys into chat, screenshots or the frontend.

# ---------------------------------------------------------------- which AI answers?
# Main language model: amd | gemma | evolus
PRIMARY_LLM_PROVIDER=amd
# Used only if the primary fails: amd | gemma | evolus | none
FALLBACK_LLM_PROVIDER=gemma
# Optional: a different provider for the AI-assisted brand review (e.g. evolus). Empty = same as above.
REVIEW_LLM_PROVIDER=

# ---------------------------------------------------------------- AMD-hosted model (REQUIRED by the hackathon)
# Copy these three values from your AMD Token Factory page (notebooks.amd.com/tokenfactory),
# or point them at your own vLLM server on AMD Developer Cloud (e.g. http://<ip>:8000/v1).
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_API_KEY=
AMD_MODEL=GLM-5.3-Flash
# What the endpoint is. Shown on the status page. token_factory | developer_cloud_vllm | other
AMD_ENDPOINT_KIND=token_factory
# Set to "none" if the endpoint rejects response_format (VYRA also detects this automatically).
AMD_JSON_MODE=json_object
# Optional prices (USD per million tokens). Leave empty if unknown: VYRA will then show cost as "unknown".
AMD_PRICE_INPUT_PER_MTOK_USD=
AMD_PRICE_OUTPUT_PER_MTOK_USD=

# ---------------------------------------------------------------- Gemma (Google open model): main translator + fallback
# Gemma is Google DeepMind's open-weights model, NOT Gemini. It is used for (1) multilingual translation (main),
# (2) the fallback for the brand review if Evolus fails and (3) the fallback for text generation if AMD fails. Never for images.
# Key: a Google AI Studio key (aistudio.google.com/apikey) works for Gemma too.
GEMMA_API_KEY=
# Exact model id: check it in AI Studio or with GET https://generativelanguage.googleapis.com/v1beta/models (names start with "gemma-")
GEMMA_MODEL=gemma-4-31b-it
GEMMA_PRICE_INPUT_PER_MTOK_USD=
GEMMA_PRICE_OUTPUT_PER_MTOK_USD=
# ROUTE 1 (recommended): Gemma served by the AMD Token Factory (same endpoint and key as the AMD model).
# Uncomment all three lines. GEMMA_MODEL must be the exact id from GET <AMD_BASE_URL>/models (case matters).
# When GEMMA_OPENAI_BASE_URL is set, the Google API route is NOT used.
# GEMMA_OPENAI_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# GEMMA_OPENAI_API_KEY=<the same key as AMD_API_KEY>
# GEMMA_MODEL=Gemma-4-31B-IT
# (Or point GEMMA_OPENAI_BASE_URL at your own vLLM server on AMD Developer Cloud.)

# ---------------------------------------------------------------- IMAGES
# Main provider: cloudflare (free daily allowance). If Cloudflare fails (no credit, outage, bad token...),
# Pollinations is used automatically for THAT image only - never otherwise. Needs POLLINATIONS_API_KEY below.
IMAGE_PROVIDER=cloudflare

# Cloudflare Workers AI (Dashboard -> Workers AI; token template "Workers AI")
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CF_IMAGE_COST_PER_IMAGE_USD=

# Pollinations: automatic backup when Cloudflare fails (or the main provider if IMAGE_PROVIDER=pollinations)
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=flux
# Optional: POLLINATIONS_BASE_URL=https://gen.pollinations.ai
# Optional price per image (USD); empty = cost shown as "unknown"
POLLINATIONS_IMAGE_COST_PER_IMAGE_USD=

# ---------------------------------------------------------------- Evolus (optional)
# Workspace values from app.evolus.ai. Only used if REVIEW_LLM_PROVIDER=evolus (or evolus is selected above).
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_AGENT_ID=
# Optional second Evolus agent used only as the translation fallback (see evolus/README.md, Part C)
EVOLUS_TRANSLATOR_AGENT_ID=

# ---------------------------------------------------------------- reliability and cost guards
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_CONCURRENCY=2
IMAGE_TIMEOUT_SECONDS=150
IMAGE_CONCURRENCY=2
# Hard ceiling on image API calls per rolling 24 hours (protects your quota and budget)
IMAGE_MAX_PER_DAY=60
# Expensive requests allowed per client per minute
RATE_LIMIT_PER_MINUTE=20
# If true, a campaign can only become "ready" after the AI-assisted review has run
REQUIRE_AI_REVIEW=false

# ---------------------------------------------------------------- server
# Optional shared access token. If set, the API needs the header X-Vyra-Token (enter it under Settings in the app).
VYRA_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_PATH=data/vyra.db
# MEDIA_DIR=media
LOG_LEVEL=INFO

# Optional storage locations (defaults: backend/data/vyra.db and backend/media)
DATABASE_PATH=
MEDIA_DIR=

# ---------------------------------------------------------------- Evolus AI Tool "Sentiment" (optional, OFF by default)
# Second Evolus building block, called through the Evolus REST API. Needs EVOLUS_API_KEY and EVOLUS_APP_ID above.
# Informational only: it never changes the brand checks. See evolus/README.md.
EVOLUS_SENTIMENT=false
# Only change the next four if Settings -> "Evolus AI Tool" -> Test connection fails (compare with your workspace's API reference).
# EVOLUS_REST_BASE_URL=https://api.evolus.ai/api/v1
# EVOLUS_SENTIMENT_TOOL=sentiment
# EVOLUS_TOOL_INPUT_FIELD=text
# EVOLUS_TOOL_EXTRA_JSON={}
